# .gitignore
# JA: 生成物・秘密・環境依存物は追跡しない。VI: Không theo dõi file sinh ra, secret, phụ thuộc môi trường.

# --- Python / Django ---
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/
venv/
myvenv/
env/
db.sqlite3
db.sqlite3-journal
staticfiles/

# --- 環境変数 / Biến môi trường ---
.env
.env.*
!.env.example

# --- Node / Vite ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- エディタ・OS / Editor & OS ---
.DS_Store
.idea/
.vscode/
*.swp

# JA: デザイン参考画像(他作品のスクリーンショット等)は第三者の著作物なのでコミットしない。
# VI: Ảnh tham khảo thiết kế (ảnh chụp tác phẩm khác...) là tác phẩm của bên thứ ba nên không commit.
.claude/design-like/
